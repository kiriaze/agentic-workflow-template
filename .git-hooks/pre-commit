#!/bin/sh
# .git-hooks/pre-commit
#
# 1. Blocks commits of src/ changes directly to main/master.
# 2. Runs quality gates if .scripts/quality-gates.sh exists.
#
# Docs-only and config changes (HANDOFF.md, AGENTS.md, docs/, etc.) may go to main.
# Setup (one-time, after clone): git config core.hooksPath .git-hooks

BRANCH=$(git branch --show-current 2>/dev/null || echo "")

# ── Branch protection ─────────────────────────────────────────────────────────
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  STAGED_SRC=$(git diff --cached --name-only | grep '^src/' || true)

  if [ -n "$STAGED_SRC" ]; then
    echo ""
    echo "BLOCKED: src/ changes cannot be committed directly to '$BRANCH'."
    echo ""
    echo "Files staged from src/:"
    echo "$STAGED_SRC" | sed 's/^/  - /'
    echo ""
    echo "Create a feature branch first:"
    echo "  git checkout -b feat/<task-name>"
    echo ""
    exit 1
  fi
fi

# ── Quality gates ─────────────────────────────────────────────────────────────
# Run project quality gates if defined. Create .scripts/quality-gates.sh with
# your lint/typecheck/test commands once your stack is chosen — it will be
# executed automatically on every commit. See docs/workflow.md for convention.
if [ -f ".scripts/quality-gates.sh" ] && [ -x ".scripts/quality-gates.sh" ]; then
  .scripts/quality-gates.sh
  if [ $? -ne 0 ]; then
    echo ""
    echo "BLOCKED: Quality gates failed. Fix the errors above before committing."
    echo ""
    exit 1
  fi
fi

exit 0
