{
  "showThinkingSummaries": true,
  "permissions": {
    "deny": ["Read(.next/**)", "Write(.next/**)", "Write(*.tsbuildinfo)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \".claude/scripts/check-branch.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \".claude/scripts/session-start.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$PWD\" && file=$(echo \"$CLAUDE_TOOL_INPUT\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('file_path',''))\" 2>/dev/null); if [[ \"$file\" == *.ts || \"$file\" == *.tsx ]]; then npx eslint --fix \"$file\" 2>/dev/null || true; fi"
          }
        ]
      }
    ]
  }
}
